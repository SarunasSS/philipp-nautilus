        "sync": true,
        "update": {
          "code": "if (context.panel.response && context.panel.response.state === 'Done') {\n  context.grafana.notifySuccess(['Strategy control', 'Configuration updated and a rollout was requested. Stopped strategies remain stopped.']);\n  context.panel.initialRequest();\n  context.grafana.refresh();\n  return;\n}\n\ncontext.grafana.notifyError(['Strategy control', 'The update failed. Reload current values before retrying.']);",
          "confirm": true,
          "contentType": "application/json",
          "datasource": "strategy-control",
          "getPayload": "const values = {};\nlet resourceVersion = '';\ncontext.panel.elements.forEach((element) => {\n  if (element.id === 'RESOURCE_VERSION') {\n    resourceVersion = String(element.value ?? '');\n    return;\n  }\n  values[element.id] = String(element.value ?? '');\n});\nconst body = JSON.stringify({ resource_version: resourceVersion, values });\nreturn {\n  BODY: JSON.stringify(body).slice(1, -1),\n};",
